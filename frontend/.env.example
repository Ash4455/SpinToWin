# 複製成 .env.local 後修改（npm run dev / npm run build 都會讀取）；未設定時使用 src/config.ts 的預設值
VITE_API_BASE_URL=/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=spintowin
VITE_KEYCLOAK_CLIENT_ID=spintowin-frontend
VITE_DEFAULT_CAMPAIGN_ID=1
# 只給 Vite dev server 用：/api 代理的目標
GATEWAY_URL=http://localhost:8000
