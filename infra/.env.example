# 複製成 infra/.env 後依需要修改；未設定的變數使用 docker-compose.yml 內的預設值。

# --- 對外（本機）port ---
# 網站（Nginx）；改成 80 以外時要一併在 Keycloak 的 spintowin-frontend client 加上對應的 redirect URI
FRONTEND_PORT=80
GATEWAY_PORT=8000
DISCOVERY_PORT=8761
MYSQL_PORT=3306
REDIS_PORT=6379
KAFKA_PORT=9092
KEYCLOAK_PORT=8080

# --- Keycloak ---
# 瀏覽器看到的 Keycloak 位址，也是 token 的 iss；改 KEYCLOAK_PORT 時要一起改
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# master realm 管理員（http://localhost:8080/admin）
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
# 應用程式帳號（各服務共用，只授權自己的 schema）
DB_USERNAME=spintowin
DB_PASSWORD=spintowin

# --- Kafka ---
# topic draw.completed 的 partition 數（只在 topic 尚未存在時生效；之後只能增加）
KAFKA_DRAW_COMPLETED_PARTITIONS=6

# --- gateway 限流（抽獎 API，每位使用者）---
# 每秒回補幾次、最多連續幾次
DRAW_RATE_LIMIT_REPLENISH_RATE=5
DRAW_RATE_LIMIT_BURST_CAPACITY=5

# --- JVM（所有 Java 服務）---
# 例：JAVA_TOOL_OPTIONS=-Xss512k
JAVA_TOOL_OPTIONS=
