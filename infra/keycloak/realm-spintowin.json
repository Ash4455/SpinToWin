{
  "realm": "spintowin",
  "displayName": "SpinToWin",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "營運人員：管理活動、獎品、庫存與統計" },
      { "name": "USER", "description": "一般使用者：查看活動、抽獎、查自己的紀錄" }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@spintowin.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "SpinToWin",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["ADMIN", "USER"]
    },
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@spintowin.local",
      "emailVerified": true,
      "firstName": "User",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "user1", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "user2",
      "enabled": true,
      "email": "user2@spintowin.local",
      "emailVerified": true,
      "firstName": "User",
      "lastName": "Two",
      "credentials": [{ "type": "password", "value": "user2", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "user3",
      "enabled": true,
      "email": "user3@spintowin.local",
      "emailVerified": true,
      "firstName": "User",
      "lastName": "Three",
      "credentials": [{ "type": "password", "value": "user3", "temporary": false }],
      "realmRoles": ["USER"]
    }
  ],
  "clients": [
    {
      "clientId": "spintowin-frontend",
      "name": "SpinToWin frontend (SPA)",
      "description": "React SPA：Authorization Code + PKCE（S256），public client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "redirectUris": ["http://localhost:5173/*", "http://localhost/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost/*"
      }
    },
    {
      "clientId": "spintowin-swagger",
      "name": "SpinToWin Swagger UI",
      "description": "gateway 上的 Swagger UI：Authorization Code + PKCE（S256），public client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/webjars/swagger-ui/oauth2-redirect.html",
        "http://localhost:8000/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": ["http://localhost:8000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "spintowin-cli",
      "name": "SpinToWin CLI (dev only)",
      "description": "僅供本機開發與冒煙測試以 curl 取得 token（password grant），正式環境不要建立",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    }
  ]
}
